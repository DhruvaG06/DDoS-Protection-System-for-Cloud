# ============================================================
# OneChance - Environment Configuration
# ============================================================

# Gateway Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DEBUG=true
ENVIRONMENT=development

# Target Application Settings (Origin Workload)
TARGET_SERVICE_URL=http://localhost:8001
TARGET_SERVICE_HOST=0.0.0.0
TARGET_SERVICE_PORT=8001

# Behavioral & Policy Engine Thresholds
RISK_THRESHOLD_CHALLENGE=40.0
RISK_THRESHOLD_BLOCK=75.0
RATE_LIMIT_WINDOW_SECONDS=10
BURST_THRESHOLD=50

# Health Monitoring & Recovery Settings
HEALTH_CHECK_INTERVAL_SECONDS=3.0
HEALTH_FAILURE_THRESHOLD=3
HEALTH_TIMEOUT_SECONDS=2.0
AUTO_RECOVERY_ENABLED=true
